# Copy to .env and fill in. .env is untracked.

# On for local development only. Off on bobby.
NYAYO_DEBUG=true

# Required when NYAYO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
NYAYO_SECRET_KEY=

# Comma separated. On bobby: 172.16.100.11,bobby.home,localhost
NYAYO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed for admin logins when NYAYO_DEBUG is off, e.g. http://172.16.100.11:8001,http://bobby.home:8001
NYAYO_CSRF_TRUSTED_ORIGINS=

# Where the SQLite database and the raw results archive live. Defaults to ./data.
# NYAYO_DATA_DIR=/home/fischer/nyayo-data

# Only when served under a path behind a reverse proxy, e.g. /nyayo.
# NYAYO_SCRIPT_NAME=
