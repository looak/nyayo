# Copy to .env and fill in. .env is untracked.

# On for local development only. Off on bobby.
NYAYO_DEBUG=true

# Required when NYAYO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
NYAYO_SECRET_KEY=

# Comma separated. On bobby: 172.16.100.11,bobby.home,localhost
NYAYO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed for admin logins when NYAYO_DEBUG is off, e.g. http://172.16.100.11:8001,http://bobby.home:8001
NYAYO_CSRF_TRUSTED_ORIGINS=

# Where the SQLite database and the raw results archive live. Defaults to ./data.
# NYAYO_DATA_DIR=/home/fischer/nyayo-data

# Where batches of finished games are kept (the game database). Defaults to games/batches in the data directory; on
# bobby, the Synology's share, which has its own backup.
# NYAYO_BATCHES_DIR=/mnt/synology/nyayo-batches

# A clone of a private git repository that `manage.py backup` commits and pushes the archive, the games and a dump of
# the database to (daily, nyayo-backup.timer). Unset, only a local copy of the database is made.
# NYAYO_BACKUP_REPO=/home/fischer/dev/nyayo-backup

# How many of each gunicorn worker's threads may handle game requests at once; the rest are kept for match reports and
# pages. Below --threads in deploy/nyayo.service (4).
# NYAYO_GAME_THREADS=2

# How much nyayo's own messages say in the journal (journalctl -u nyayo): DEBUG, INFO, WARNING. Server errors are
# always logged with their traceback.
# NYAYO_LOG_LEVEL=INFO

# Only when served under a path behind a reverse proxy, e.g. /nyayo.
# NYAYO_SCRIPT_NAME=
