# systemd unit for nyayo on bobby. deploy/install-service.sh fills in User, WorkingDirectory and the env's bin path
# for the checkout and conda env it runs from, then installs and starts it.

[Unit]
Description=nyayo smoke test history
After=network-online.target
Wants=network-online.target

[Service]
User=fischer
WorkingDirectory=/home/fischer/dev/nyayo
ExecStart=/home/fischer/miniconda3/envs/nyayo/bin/gunicorn nyayo.wsgi:application --bind 0.0.0.0:8001 --workers 4 --worker-class gthread --threads 4 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
