# systemd unit for nyayo on bobby. Install with:
#   sudo cp deploy/nyayo.service /etc/systemd/system/nyayo.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now nyayo
# Adjust the conda env path if `conda env list` shows it elsewhere.

[Unit]
Description=nyayo smoke test history
After=network-online.target
Wants=network-online.target

[Service]
User=fischer
WorkingDirectory=/home/fischer/nyayo
ExecStart=/home/fischer/miniconda3/envs/nyayo/bin/gunicorn nyayo.wsgi:application --bind 0.0.0.0:8001 --workers 2 --access-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
